# Supply-chain settings. They need npm 12, which package.json asks for in
# "devEngines": older versions print a warning on every npm command, and ignore
# some or all of these settings. CI installs npm 12: see
# .github/actions/setup-node-npm.
#
# npm only reads the .npmrc in the project's own folder, so every sub-project
# (tests/browser, examples/*, tests/react-native-metro/fixtures/*) has an
# .npmrc that is a symlink to this file. Add one for any new package.json.

# Don't install a version published less than 7 days ago. Malicious versions
# are usually found and unpublished within that time.
min-release-age=7

# No dependencies from git repositories or tarball URLs, only from the registry.
allow-git=none
allow-remote=none

# Treat unknown keys in .npmrc files as errors instead of ignoring them, so a
# typo can't silently turn off one of the settings above.
strict-npmrc=true

# Install scripts of dependencies only run if they are approved in the
# "allowScripts" field of package.json (npm approve-scripts / npm deny-scripts).
